.DS_Store
.client-build/
node_modules
.pnpm-store/

# Local credentials and environment overrides must never be committed.
.env
.env.*
.npmrc
*.pem
*.key

# Local build/test output. lib/ is produced by `pnpm run build` on every
# checkout (CI builds it; npm pack runs after the build).
lib/
coverage/
*.log
*.tgz

# Local visual acceptance evidence may contain workspace or conversation data.
artifacts/

# Android bridge intermediates — regenerate with scripts/build-bridge*.ps1.
# The FINAL apk is deliberately NOT ignored: it is the artifact a user must
# install on their device, and a plugin that names a file the package does
# not contain is worse than one that never mentions it.
android-bridge/build/
android-bridge/dsh-bridge.apk.idsig
# Debug signing key: local only, never shipped or shared.
android-bridge/debug.keystore
